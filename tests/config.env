# Copy to config.local.env; do not commit secrets.
NAMESPACE=app
KEDA_NAMESPACE=keda
NODEPOOL=general
PROM_URL=http://onprem-gateway.monitoring.svc:9090
# 온프레미스(VM1) 쿠버네티스: CNPG가 여기에 있음. kubeconfig context 이름 (README 4.1)
ONPREM_KUBE_CONTEXT=
DB_NAMESPACE=database
CNPG_CLUSTER=
RDS_IDENTIFIER=pantry-mate-dev-postgres
AWS_REGION=ap-northeast-2
SLO_TARGET=99.9
# Set actual safe, read-only URLs; blank means skip the service.
FRONTEND_URL=
GATEWAY_URL=
USER_URL=
PRODUCT_URL=
ORDER_PAYMENT_URL=
PANTRY_RECIPE_URL=
NOTIFICATION_URL=
