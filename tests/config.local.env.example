# cp config.local.env.example config.local.env 후 실제 값으로 수정 (config.local.env는 git에 올라가지 않음)

# 온프레미스(VM1) 쿠버네티스 context. `kubectl config get-contexts`로 확인
ONPREM_KUBE_CONTEXT=
# VM1에서 `kubectl get cluster -A`로 확인
DB_NAMESPACE=database
CNPG_CLUSTER=

# 사용자 트래픽 경로(Cloudflare 경유)의 읽기 전용 URL. 비워두면 해당 서비스는 부하 대상에서 제외
FRONTEND_URL=https://www.unzipp.cloud/
GATEWAY_URL=https://api.unzipp.cloud/actuator/health
PRODUCT_URL=https://api.unzipp.cloud/api/products
PANTRY_RECIPE_URL=https://api.unzipp.cloud/api/recipes
USER_URL=
ORDER_PAYMENT_URL=
NOTIFICATION_URL=
