        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=2;" edge="1" source="apigw" target="lambda" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="HTTP :8080&#xa;서명 검증 후 포워딩" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=2;fontSize=10;" edge="1" source="lambda" target="p_jenkins" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- EKS → NAT → IGW → Internet -->
        <mxCell id="e6" value="외부 트래픽&#xa;(ECR pull 등)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" source="eks" target="nat2a" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;strokeWidth=1.5;" edge="1" source="nat2a" target="igw" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;strokeWidth=1.5;" edge="1" source="nat2c" target="igw" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;strokeWidth=1.5;" edge="1" source="igw" target="internet" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Jenkins → dynamic agents -->
        <mxCell id="e10" value="동적 에이전트 생성" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d97706;strokeWidth=2;dashed=1;fontSize=10;" edge="1" source="p_jenkins" target="w1k" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Argo CD → Worker deploy -->
        <mxCell id="e11" value="K8s 배포" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#db2777;strokeWidth=2;fontSize=10;" edge="1" source="p_argo" target="warea" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- OTel → On-Premise (Tailscale) -->
        <mxCell id="e12" value="Tailscale VPN&#xa;메트릭 / 로그 / 트레이스" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=3;fontSize=11;fontStyle=1;" edge="1" source="p_otel" target="mon" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- DCGM → OTel -->
        <mxCell id="e13" value="GPU 메트릭" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;strokeWidth=1.5;dashed=1;fontSize=10;" edge="1" source="p_dcgm" target="p_otel" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- EKS → DB (Tailscale) -->
        <mxCell id="e14" value="DB 연결  (Tailscale)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;fontSize=10;" edge="1" source="warea" target="db" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Jenkins → ECR -->
        <mxCell id="e15" value="이미지 push/pull" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=1.5;dashed=1;fontSize=10;" edge="1" source="p_jenkins" target="ecr_svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Tailscale pod → On-Prem (VPN tunnel indicator) -->
