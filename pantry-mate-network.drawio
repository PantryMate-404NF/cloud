        <!-- ══════════════════════════════════════════════ -->
        <!--  Edges / Traffic Flows                         -->
        <!-- ══════════════════════════════════════════════ -->

        <!-- GitHub → API Gateway -->
        <mxCell id="e1" value="&lt;b&gt;HTTPS POST /webhook&lt;/b&gt;&#xa;X-Hub-Signature-256"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=2.5;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;"
          edge="1" source="github" target="apigw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Gateway → Lambda -->
        <mxCell id="e2" value="AWS_PROXY Invoke"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=2.5;fontSize=10;"
          edge="1" source="apigw" target="lambda" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda → Jenkins NLB -->
        <mxCell id="e3" value="&lt;b&gt;HTTP :8080&lt;/b&gt;&#xa;/github-webhook/&#xa;서명 검증 후 포워딩"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#e65100;strokeWidth=2.5;fontSize=10;"
          edge="1" source="lambda" target="nlb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Jenkins NLB → Jenkins Controller -->
        <mxCell id="e4" value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d97706;strokeWidth=2;"
          edge="1" source="nlb" target="jenkins" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Jenkins → Worker (dynamic agents) -->
        <mxCell id="e5" value="동적 에이전트&#xa;프로비저닝"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563eb;strokeWidth=2;dashed=1;fontSize=10;"
          edge="1" source="jenkins" target="worker_content" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EKS → NAT 2a (internet egress) -->
        <mxCell id="e6" value="0.0.0.0/0&#xa;(ECR pull 등)"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontSize=9;"
          edge="1" source="eks" target="nat2a" parent="1">
