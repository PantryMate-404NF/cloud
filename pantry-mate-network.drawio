        <!-- NAT 2a → IGW -->
        <mxCell id="e7" value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;strokeWidth=2;"
          edge="1" source="nat2a" target="igw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NAT 2c → IGW -->
        <mxCell id="e8" value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;strokeWidth=2;"
          edge="1" source="nat2c" target="igw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- IGW → Internet -->
        <mxCell id="e9" value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3b82f6;strokeWidth=2;"
          edge="1" source="igw" target="internet" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda → SSM (읽기) -->
        <mxCell id="e10" value="HTTPS 443&#xa;secret 읽기"
          style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;strokeWidth=1.5;dashed=1;fontSize=9;"
