region       = "ap-northeast-2"
project_name = "pantry-mate"
environment  = "dev"

terraform_state_bucket_name = "CHANGE_ME_TO_BOOTSTRAP_BUCKET_NAME"
foundation_state_key        = "dev/foundation/terraform.tfstate"

nat_instance_type = "t3.nano"

# AWS Console에서 미리 생성한 EC2 Key Pair 이름입니다.
# 실제 .pem 파일과 private/public key 내용은 Terraform에서 관리하지 않습니다.
ec2_key_name = "CHANGE_ME"

# NAT Bastion SSH를 허용할 개발자 공인 IPv4 주소로 변경합니다.
# 0.0.0.0/0은 사용할 수 없으며 IPv4 /32만 허용됩니다.
ssh_allowed_cidrs = ["203.0.113.10/32"]

eks_cluster_name           = "pantry-mate-dev-eks"
eks_kubernetes_version     = "1.35"
# 로컬 PC에서 kubectl로 접근해야하는 경우 true로 변경
eks_endpoint_public_access = false
# true일 경우 아래 CIDR은 현재 ["사용자 공인 IP/32"] 로 변경하기
# curl ifconfig.me << 이걸로 ip 확인하시고
# 0.0.0.0/0은 안됩니다
eks_public_access_cidrs = ["203.0.113.10/32"]

manage_node_instance_type = "t3.large"
manage_node_capacity_type = "ON_DEMAND"
manage_node_min_size      = 1
manage_node_max_size      = 1
manage_node_desired_size  = 1
manage_node_labels = {
  role = "manage"
}

worker_node_instance_type = "t3.medium"
worker_node_capacity_type = "SPOT"
worker_node_min_size      = 3
worker_node_max_size      = 3
worker_node_desired_size  = 3
worker_node_labels = {
  role = "worker"
}

gpu_node_instance_type = "g4dn.xlarge"
gpu_node_min_size      = 0
gpu_node_max_size      = 1
gpu_node_desired_size  = 0

ecr_repository_names = [
  "pantry-mate-dev-frontend",
  "pantry-mate-dev-backend",
  "pantry-mate-dev-ai",
]

s3_versioning_enabled         = true
cloudwatch_log_retention_days = 14
extra_tags                    = {}

# ── Jenkins CI/CD ─────────────────────────────────────────────────────────────
# 민감한 값(jenkins_admin_password, github_webhook_secret, github_api_token)은
# terraform.tfvars 파일에 직접 입력하지 말고 환경변수 또는 AWS Secrets Manager를 사용하세요.
#
#   export TF_VAR_jenkins_admin_password="강력한비밀번호"
#   export TF_VAR_github_webhook_secret="랜덤32자이상문자열"   # openssl rand -hex 32
#   export TF_VAR_github_api_token="ghp_xxxxxxxxxxxxxxxxxxxx"

github_org         = "your-github-org"       # GitHub 조직명 또는 계정명
frontend_repo_name = "pantry-mate-frontend"  # 프론트엔드 레포지토리 이름
backend_repo_name  = "pantry-mate-backend"   # 백엔드 레포지토리 이름

# ── Argo CD (GitOps CD) ───────────────────────────────────────────────────────
# gitops_repo_token은 환경변수로 주입하세요.
#   export TF_VAR_gitops_repo_token="ghp_xxxxxxxxxxxxxxxxxxxx"

gitops_repo_url = "https://github.com/your-github-org/pantry-mate-gitops"
app_namespace   = "app"
